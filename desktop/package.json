{
  "name": "thephonesearch-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop control app for ThePhoneSearch eBay and MobileParts workflow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thephonesearch.desktop",
    "productName": "ThePhoneSearch",
    "asar": true,
    "files": ["main.js"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis"]},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
